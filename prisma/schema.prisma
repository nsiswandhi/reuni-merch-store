generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  // Preorder reservation, before the minimum quota is met — no payment
  // requested yet. Regular (non-preorder) orders skip this status entirely
  // and start straight at PENDING_PAYMENT.
  RESERVED
  PENDING_PAYMENT
  AWAITING_CONFIRMATION
  PAID
  EXPIRED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  SHIPPING
}

enum FulfillmentStatus {
  PROCESSING
  // Preorder-specific: vendor is producing the goods (1-2 weeks) after
  // payment is confirmed but before they're ready to ship/hand off.
  IN_PRODUCTION
  DONE
}

enum AvailabilityMode {
  ALWAYS
  LAST_ORDER_DATE
  STOCK
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Vendor {
  id           String   @id @default(cuid())
  brandName    String
  ownerName    String
  angkatan     String
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  // Some vendors can't hand off items in person at the event venue and can
  // only ship — defaults to true so existing vendors keep today's behavior
  // (both pickup and shipping allowed) until an admin turns it off.
  allowsPickup Boolean  @default(true)
  createdAt    DateTime @default(now())
  products     Product[]
  orderItems   OrderItem[]
}

model Product {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  name        String
  slug        String    @unique
  description String    @default("")
  imageUrl    String    @default("")
  basePrice   Int
  isActive    Boolean   @default(true)
  availabilityMode AvailabilityMode @default(ALWAYS)
  lastOrderAt DateTime?
  stock       Int?
  // Preorder / group-buy mode: buyers "reserve" instead of buying outright,
  // and no payment is requested until preorderReservedQty reaches
  // preorderMinQty (see the RESERVED order status). Once a round's quota is
  // met, preorderReservedQty resets to 0 so the next round starts counting
  // fresh automatically.
  isPreorder           Boolean  @default(false)
  preorderMinQty       Int?
  preorderReservedQty  Int      @default(0)
  // Free-text admin note shown to buyers next to preorder quota progress
  // (product detail page, order detail page) — e.g. production lead time
  // and estimated ship date. Optional; null renders nothing.
  preorderNote         String?
  createdAt   DateTime  @default(now())
  variants    ProductVariant[]
  orderItems  OrderItem[]
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  label      String
  price      Int
  sku        String   @default("")
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  orderItems OrderItem[]
}

model AdminSettings {
  id                    String  @id @default("singleton")
  bankName              String  @default("")
  bankAccountNumber     String  @default("")
  bankAccountName       String  @default("")
  shippingFlatRate      Int     @default(0)
  adminNotificationEmail String @default("")
  qrisImageUrl          String?
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  token           String         @unique
  buyerName       String
  buyerAngkatan   String
  buyerEmail      String
  buyerWhatsapp   String
  deliveryMethod  DeliveryMethod
  shippingAddress String?
  subtotal        Int
  shippingCost    Int
  total           Int
  status          OrderStatus    @default(PENDING_PAYMENT)
  paymentProofUrl String?
  proofUploadedAt DateTime?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  reminderCount   Int            @default(0)
  // True for orders created via the preorder/reservation flow (status starts
  // at RESERVED instead of PENDING_PAYMENT). Denormalized here so it doesn't
  // need a join through items -> product for admin filtering/display.
  isPreorder          Boolean   @default(false)
  // When the 3-day payment window actually started — set once the
  // preorder's quota is met (not at order creation time, which for a
  // preorder order is just when the buyer reserved). The daily reminder
  // cron uses this (falling back to createdAt for regular orders) so the
  // existing 24h/48h/72h reminder cadence works unchanged for both flows.
  paymentDueStartedAt DateTime?
  createdAt       DateTime       @default(now())
  items           OrderItem[]
}

model OrderItem {
  id                    String            @id @default(cuid())
  orderId               String
  order                 Order             @relation(fields: [orderId], references: [id])
  productId             String
  product               Product           @relation(fields: [productId], references: [id])
  variantId             String?
  variant               ProductVariant?   @relation(fields: [variantId], references: [id])
  vendorId              String
  vendor                Vendor            @relation(fields: [vendorId], references: [id])
  productNameSnapshot   String
  variantLabelSnapshot  String            @default("")
  unitPriceSnapshot     Int
  qty                   Int
  fulfillmentStatus     FulfillmentStatus @default(PROCESSING)

  @@index([vendorId])
  @@index([orderId])
}
