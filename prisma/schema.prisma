generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_CONFIRMATION
  PAID
  EXPIRED
}

enum DeliveryMethod {
  PICKUP
  SHIPPING
}

enum FulfillmentStatus {
  PROCESSING
  DONE
}

enum AvailabilityMode {
  ALWAYS
  LAST_ORDER_DATE
  STOCK
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Vendor {
  id           String   @id @default(cuid())
  brandName    String
  ownerName    String
  angkatan     String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  products     Product[]
  orderItems   OrderItem[]
}

model Product {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id])
  name        String
  slug        String    @unique
  description String    @default("")
  imageUrl    String    @default("")
  basePrice   Int
  isActive    Boolean   @default(true)
  availabilityMode AvailabilityMode @default(ALWAYS)
  lastOrderAt DateTime?
  stock       Int?
  createdAt   DateTime  @default(now())
  variants    ProductVariant[]
  orderItems  OrderItem[]
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  label      String
  price      Int
  sku        String   @default("")
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  orderItems OrderItem[]
}

model AdminSettings {
  id                    String @id @default("singleton")
  bankName              String @default("")
  bankAccountNumber     String @default("")
  bankAccountName       String @default("")
  shippingFlatRate      Int    @default(0)
  adminNotificationEmail String @default("")
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  token           String         @unique
  buyerName       String
  buyerAngkatan   String
  buyerEmail      String
  buyerWhatsapp   String
  deliveryMethod  DeliveryMethod
  shippingAddress String?
  subtotal        Int
  shippingCost    Int
  total           Int
  status          OrderStatus    @default(PENDING_PAYMENT)
  paymentProofUrl String?
  proofUploadedAt DateTime?
  confirmedAt     DateTime?
  reminderCount   Int            @default(0)
  createdAt       DateTime       @default(now())
  items           OrderItem[]
}

model OrderItem {
  id                    String            @id @default(cuid())
  orderId               String
  order                 Order             @relation(fields: [orderId], references: [id])
  productId             String
  product               Product           @relation(fields: [productId], references: [id])
  variantId             String?
  variant               ProductVariant?   @relation(fields: [variantId], references: [id])
  vendorId              String
  vendor                Vendor            @relation(fields: [vendorId], references: [id])
  productNameSnapshot   String
  variantLabelSnapshot  String            @default("")
  unitPriceSnapshot     Int
  qty                   Int
  fulfillmentStatus     FulfillmentStatus @default(PROCESSING)

  @@index([vendorId])
  @@index([orderId])
}
